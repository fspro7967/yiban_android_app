<?xml version="1.0"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yiban.elder"
    android:installLocation="auto"
    android:versionCode="-- %%INSERT_VERSION_CODE%% --"
    android:versionName="-- %%INSERT_VERSION_NAME%% --">
    <!-- 允许访问网络：后续接入提醒后端同步 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 判断有没有网（SyncVM 的 offline 态靠它，不用发请求试探） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 提醒：Android 13+ 通知要用户点头才能弹 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 精确闹钟：Android 12+ 用 setAlarmClock/setExact 必须声明，否则只能退化成非精确 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Android 13+ 的闹钟类应用自动获得精确闹钟权限，不必再引导用户去设置里点 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 锁屏全屏提醒：没有它 setFullScreenIntent 只会在状态栏留一条；
         14+ 还要用户在"全屏通知"里单独放行，代码见 YibanPlatform.canUseFullScreenIntent -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 闹钟到点要把屏幕叫醒 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 响铃前台服务：Android 14 起前台服务必须声明类型并配对应权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- B2-2：连着灯板时的连接前台服务，Android 14 起要单独声明类型权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- 把闹铃音量拉到最大，静音模式下也能听见 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 关机重启后重建闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 部分国产 ROM 会杀后台，引导用户加白名单 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 紧急呼救：直接拨号 + 短信兜底；语音记一笔要用麦克风 -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ 需要声明 TTS 服务的可见性，否则 TextToSpeech 找不到引擎 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- %%INSERT_PERMISSIONS -->
    <!-- %%INSERT_FEATURES -->
    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true" />
    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:hardwareAccelerated="true"
        android:label="-- %%INSERT_APP_NAME%% --"
        android:icon="-- %%INSERT_APP_ICON%% --"
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="true"
        android:fullBackupOnly="false"
        android:usesCleartextTraffic="true">
        <activity
            android:name="org.qtproject.qt.android.bindings.QtActivity"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:label="-- %%INSERT_APP_NAME%% --"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

          <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --" />

          <meta-data
                android:name="android.app.arguments"
                android:value="-- %%INSERT_APP_ARGUMENTS%% --" />

          <!-- B2-2：灭屏/切后台不让 Qt 暂停事件循环，5 秒心跳不断 -->
          <meta-data
                android:name="android.app.background_running"
                android:value="true" />
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.qtprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/qtprovider_paths"/>
        </provider>

        <!-- 到点闹钟的落点：只拉起 AlarmService，不起 Activity（见 AlarmReceiver.java） -->
        <receiver
            android:name="com.yiban.elder.AlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 响铃 + 语音播报：前台服务，锁屏/进程被回收时也能出声（见 AlarmService.java） -->
        <service
            android:name="com.yiban.elder.AlarmService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- B2-2：连着床头灯板期间的前台服务，常驻通知+connectedDevice 类型，
             让系统在灭屏/切后台时别把 5 秒心跳的 Qt 主循环冻住。断开时端上停掉。 -->
        <service
            android:name="com.yiban.elder.ConnectionService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- B2-4：device owner 的 device admin。设成 owner 后 startLockTask 不弹
             "屏幕固定"确认；退出仍走 DeviceVM.exitKiosk() 的看护人通道。 -->
        <receiver
            android:name="com.yiban.elder.AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- 短信确认弹窗的自动确认（见 SmsConfirmService.java）。
             平时完全不活动：只在呼救发出后的 15 秒内、且只对 HyperOS 权限
             弹窗起作用。root 下由 YibanPlatform 自动开启，无 root 需用户
             在无障碍设置里手动启用一次。 -->
        <service
            android:name="com.yiban.elder.SmsConfirmService"
            android:exported="false"
            android:label="@string/yiban_sms_confirm_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/sms_confirm_service" />
        </service>

        <!-- 开机/升级重建闹钟。
             必须 exported="true"：BOOT_COMPLETED 由系统进程投递，
             写成 false 时广播到不了，表现就是"重启后提醒全部失效"。 -->
        <receiver
            android:name="com.yiban.elder.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
